rules_version = '2';

// Each person can only ever touch documents under their own user id. Everything else is denied,
// which is what makes the public web config in src/lib/firebase.ts safe to publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/rows/{rowId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function isValidRow() {
        let d = request.resource.data;
        return d.keys().hasOnly(['table', 'id', 'updatedAt', 'json', 'syncedAt'])
          && d.table is string
          && d.id is string
          && d.updatedAt is number
          && d.json is string
          && d.json.size() < 900000
          && d.syncedAt == request.time;
      }
      allow read, delete: if isOwner();
      allow create, update: if isOwner() && isValidRow();
    }
  }
}
